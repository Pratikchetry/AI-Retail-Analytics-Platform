      <column caption='Recommended Action' datatype='string' name='[Calculation_1491977166045184]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [customer_segment] = &apos;Champions&apos;&#10;THEN &apos;Reward &amp; Retain&apos;&#10;&#10;ELSEIF [customer_segment] = &apos;Loyal Customers&apos;&#10;THEN &apos;Loyalty Programs&apos;&#10;&#10;ELSEIF [customer_segment] = &apos;Potential Loyalists&apos;&#10;THEN &apos;Upsell &amp; Nurture&apos;&#10;&#10;ELSEIF [customer_segment] = &apos;At Risk&apos;&#10;THEN &apos;Immediate Re-engagement&apos;&#10;&#10;ELSEIF [customer_segment] = &apos;Lost Customers&apos;&#10;THEN &apos;Win-back Campaign&apos;&#10;&#10;END' />
      </column>
      <column caption='Action Label' datatype='string' name='[Calculation_1491977166487553]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1491977166045184] = &quot;Immediate Re-engagement&quot; AND [customer_segment] = &quot;At Risk&quot;&#10;THEN &quot;🔴 Priority&quot;&#10;ELSEIF [Calculation_1491977166045184] = &quot;Loyalty Programs&quot; AND [customer_segment] = &quot;Loyal Customers&quot;&#10;THEN &quot;🟢 Core play&quot;&#10;ELSEIF [Calculation_1491977166045184] = &quot;Win-back Campaign&quot; AND [customer_segment] = &quot;Others&quot;&#10;THEN &quot;🟡 Engage&quot;&#10;ELSEIF [Calculation_1491977166045184] = &quot;Upsell &amp; Nurture&quot; AND [customer_segment] = &quot;Potential Loyalists&quot;&#10;THEN &quot;🟣 Grow&quot;&#10;ELSEIF [Calculation_1491977166045184] = &quot;Reward &amp; Retain&quot; AND [customer_segment] = &quot;Champions&quot;&#10;THEN &quot;🔵 VIP&quot;&#10;ELSEIF [Calculation_1491977166045184] = &quot;Win-back Campaign&quot; AND [customer_segment] = &quot;Lost Customers&quot;&#10;THEN &quot;⚫ Re-activate&quot;&#10;END' />
      </column>
      <column caption='Segment Color' datatype='integer' name='[Calculation_1491977166602242]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [customer_segment] = &quot;At Risk&quot; THEN 1&#10;ELSEIF [customer_segment] = &quot;Champions&quot; THEN 2&#10;ELSEIF [customer_segment] = &quot;Lost Customers&quot; THEN 3&#10;ELSEIF [customer_segment] = &quot;Loyal Customers&quot; THEN 4&#10;ELSEIF [customer_segment] = &quot;Others&quot; THEN 5&#10;ELSEIF [customer_segment] = &quot;Potential Loyalists&quot; THEN 6&#10;END' />
      </column>
