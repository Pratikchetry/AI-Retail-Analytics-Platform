      <aliases enabled='yes' />
      <column caption='Product Category' datatype='string' name='[Calculation_2934949094424577]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([total_revenue]) &gt;= 100000 AND SUM([total_quantity]) &gt;= 50000 THEN &quot;Superstar Product&quot;&#10;&#10;ELSEIF SUM([total_revenue]) &gt;= 100000 AND SUM([total_quantity]) &lt; 50000 THEN &quot;Premium Product&quot;&#10;&#10;ELSEIF SUM([total_revenue]) &lt; 100000 AND SUM([total_quantity]) &gt;= 50000 THEN &quot;Mass Market Product&quot;&#10;&#10;ELSE &quot;Underperforming Product&quot;&#10;&#10;END' />
